// Простая hash-функция для строки: сумма байт + умножение.
// В реальном коде замените на std::hash<std::string_view> или криптографическую.
inline std::size_t hash_string(std::string_view key) {
    std::size_t hash = 14695981039346656037ULL;
    for (unsigned char c : key) {
        hash ^= static_cast<std::size_t>(c);
        hash *= 1099511628211ULL;
    }
    return hash;
}

// Структура ячейки хеш-таблицы. `removed` отмечает удалённую ячейку, чтобы
// при обходе не прерывать probing и чтобы вставка могла использовать её.
struct Cell {
    std::string key;
    bool removed = false;

    Cell() = default;
    explicit Cell(std::string key) : key(std::move(key)) {}
};

    // Вставить ключ. Если ключ уже есть, ничего не делает.
    void insert(const Key& key) {
        if (is_full()) {
            std::cerr << "[INFO] load_factor >= 1; перехэширование невозможно "
                         "(capacity ограничена) / "
                      << "load_factor >= 1; rehash not possible (capacity "
                         "bounded); throwing.\n";
            throw std::runtime_error("HashSet is full");
        }
        if (contains(key)) {
            return;
        }

        std::size_t index = hash(key) % capacity_;
        std::vector<std::size_t> probes;
        std::size_t start = index;
        std::size_t i = 0;

        // Quadratic probing: i = 0, 1, 2, ... -> 0, 1, 4, 9, 16, ...
        do {
            probes.push_back(index);
            if (buckets_[index].removed || buckets_[index].key.empty()) {
                buckets_[index] = Cell(key);
                ++count_;
                std::cout << "insert \"" << key << "\" -> index "
                          << index << " (probe " << i << ")\n";
                return;
            }
            ++i;
            index = (static_cast<std::ssize_t>(index) + i * i) % capacity_;
        } while (i <= capacity_);

        throw std::runtime_error("Quadratic probing cycle detected");
    }

// Запуск демонстрации.
int main() {
    std::cout << "=== Quadratic probing in HashSet (Open Addressing) ===\n";

    // Пример: простая последовательность ключей, вызывающая коллизии.
    std::vector<std::string> keys = {
        "apple", "april", "banana", "berry", "cherry", "date",
        "elder", "fig", "grape", "guava", "honey", "mint",
        "orange", "papaya", "kiwi", "lemon", "mango", "nectarine",
    };

    // capacity = 16, load factor = 0.75 -> при ~12 элементах будет предел.
    // Показываем, как ведёт себя квадратическое пробирование при вставке.
    QuadraticHashSet<std::string> set(16, 0.75);

    std::cout << "\n--- Вставка ключей ---\n";
    for (const auto& key : keys) {
        std::cout << "insert \"" << key << "\": ";
        try {
            set.insert(key);
            std::cout << "OK\n";
        } catch (const std::exception& e) {
            std::cout << "FAIL: " << e.what() << "\n";
        }
    }

    // Структура данных содержит только уникальные ключи.
    std::cout << "\n--- Проверка уникальности ---\n";
    set.print(keys);
    std::cout << "contains 'apple': " << set.contains("apple") << "\n";
    std::cout << "contains 'applex': " << set.contains("applex") << "\n";
    std::cout << "size=" << set.size() << ", expected " << keys.size()
              << "\n";

    // Демонстрация удаления.
    std::cout << "\n--- Удаление ---\n";
    const std::string remove_key = "cherry";
    std::cout << "remove \"" << remove_key << "\": "
              << (set.remove(remove_key) ? "OK" : "not found") << "\n";
    std::cout << "contains \"" << remove_key << "\": "
              << set.contains(remove_key) << "\n";
    std::cout << "contains removed \"" << remove_key
              << "\" after deletion: " << set.contains(remove_key)
              << " (should be false)\n";

    // Удалённая ячейка должна быть проходима новой вставкой.
    std::cout << "\n--- Вставка после удаления ---\n";
    std::string reinsert_key = "cherry";
    set.insert(reinsert_key);
    std::cout << "after reinsert, contains \"" << reinsert_key << "\": "
              << set.contains(reinsert_key) << "\n";
    std::cout << "size=" << set.size() << ", expected " << keys.size()
              << "\n";

    // Пример того, как нагрузка растёт.
    std::cout << "\n--- Наконец, переполнение ---\n";
    std::cout << "Final: capacity=" << set.capacity_ << ", count="
              << set.size() << ", load=" << set.load_factor() << "\n";

    // Проверка матча: множество найдёт каждый из первоначальных ключей.
    bool all_found = true;
    for (const auto& key : keys) {
        if (!set.contains(key)) {
            all_found = false;
            break;
        }
    }
    std::cout << "\nПроверка: все " << keys.size() << " уникальных ключей "
                 "найдены: "
              << (all_found ? "OK" : "FAIL") << "\n";
    return all_found ? 0 : 1;
}

    // Проверить принадлежность.
    bool contains(const Key& key) const {
        std::size_t index = hash(key) % capacity_;
        std::size_t start = index;
        std::size_t i = 0;

        while (true) {
            Cell& cell = buckets_[index];
            if (cell.key == key && !cell.removed) {
                return true;
            }
            if (cell.key.empty() && !cell.removed) {
                return false;  // Пустая ячейка = слот закончился
            }
            ++i;
            index = (static_cast<std::ssize_t>(index) + i * i) %
                    capacity_;
            if (index == start) {
                return false;
            }
        }
    }

    // Удалить ключ. Возвращает true, если ключ был найден.
    bool remove(const Key& key) {
        std::size_t index = hash(key) % capacity_;
        std::size_t start = index;
        std::size_t i = 0;

        while (true) {
            Cell& cell = buckets_[index];
            if (cell.key == key && !cell.removed) {
                cell.removed = true;
                --count_;
                return true;
            }
            if (cell.key.empty() && !cell.removed) {
                return false;
            }
            ++i;
            index = (static_cast<std::ssize_t>(index) + i * i) %
                    capacity_;
            if (index == start) {
                return false;
            }
        }
    }

    // Количество реальных элементов.
    std::size_t size() const { return count_; }
    bool empty() const { return count_ == 0; }

    // Показатель заполнения.
    double load_factor() const {
        return capacity_ > 0 ? static_cast<double>(count_) / capacity_ : 0.0;
    }

    void print(const std::vector<Key>& keys) const {
        std::cout << "keys:";
        for (const auto& k : keys) {
            std::cout << " " << k;
        }
        std::cout << "\ncapacity=" << capacity_ << " count=" << count_
                  << " load=" << load_factor() << "\n";
    }

   private:
    static std::size_t next_power_of_two(std::size_t v) {
        v--;
        v |= v >> 1;
        v |= v >> 2;
        v |= v >> 4;
        v |= v >> 8;
        v |= v >> 16;
        v |= v >> 32;
        v++;
        return std::min(v, max_capacity());
    }

    bool is_full() const { return load_factor_ <= 1.0 && count_ >= capacity_; }

    std::size_t hash(const Key& key) const {
        if constexpr (std::is_same_v<Key, std::string>) {
            return hash_string(key);
        } else {
            std::hash<Key> hasher{};
            return hasher(key);
        }
    }

    std::vector<Cell> buckets_;
    std::size_t capacity_;
    double load_factor_;
    std::size_t count_;
};

// Фиксированный максимум для иллюстрации: если ёмкость превысит это,
// пример не сможет дальше расти (на практике увеличивайте capacity).
inline std::size_t max_capacity() {
    return 257;
}

// Хеш-множество с линейными индексами и quadratic probing при коллизиях.
template <typename Key = std::string>
class QuadraticHashSet {
   public:
    explicit QuadraticHashSet(std::size_t capacity = 16,
                              double load_factor = 0.75)
        : capacity_(next_power_of_two(std::max(capacity, 1ULL))),
          load_factor_(load_factor),
          count_(0) {
        buckets_.assign(capacity_, Cell());
    }

   linear probing.
3. **Недостаток:** при определённых наборах ключей последовательности
   исследования могут не охватить все слоты (например, если `capacity` и
   константа являются степенями двойки, спрямление может зациклиться).
   Поэтому на практике:
   - ёмкость выбирают простым числом или в степень простого;
   - при `loadFactor >= 1` готовы уже к перехэшированию;
   - при вставке сначала делают `find`, чтобы не вставлять дубликаты;
   - при удалении используют флаг `kRemoved`, чтобы обход не останавливался на
     пустом слоте, но при этом продолжал искать удаляемую запись и
     вставляемые элементы могли продолжить probing-поиск далее.
